{
  "name": "axon-harness",
  "version": "1.1.1",
  "description": "AI-Native Engineering Harness: State machine, Anti-UBB context compressor, and SDD/BDD/TDD orchestrator.",
  "type": "module",
  "bin": {
    "axon": "./bin/axon.js",
    "axon-harness": "./bin/axon.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    ".agents",
    ".harness",
    "docs",
    "specs",
    "install.sh"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "init": "node ./bin/axon.js init"
  },
  "keywords": [
    "ai",
    "harness",
    "antigravity",
    "cursor",
    "sdd",
    "bdd",
    "tdd",
    "mcp",
    "context-compressor",
    "token-budget",
    "state-machine"
  ],
  "author": "Axon",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "vitest": "^3.0.7"
  }
}
